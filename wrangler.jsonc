{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ciaosusi-auguri",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "https://ciaosusi.it/auguri.html*",
      "zone_name": "ciaosusi.it"
    },
    {
      "pattern": "https://ciaosusi.it/auguri/*",
      "zone_name": "ciaosusi.it"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ciaosusi-auguri",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
